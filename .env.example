# ==============================================================================
# AURA DIGITAL DINING - CONSOLIDATED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally. DO NOT commit production secrets to Git.
# ==============================================================================

# Application Execution Profile
APP_ENV=development                       # Options: development, staging, production
PORT=8080                                  # Spring Boot REST API Port
FRONTEND_URL=http://localhost:5173          # Allowed CORS Origin

# PostgreSQL Database Configuration (Neon or Local Postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant_db?sslmode=disable
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security & JWT Configuration
# Generate a 256-bit key using `openssl rand -hex 32`
JWT_SECRET=401b61e0369fed0476d9f7c5d6f0c72719a86895311e63a15f013
JWT_EXPIRATION_MS=900000                   # 15 Minutes
JWT_REFRESH_EXPIRATION_MS=604800000       # 7 Days

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=aura-restaurant
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# SMTP Mail Server Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
