# ==============================================================================
# AURA GASTRONOMY - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to backend/.env and replace placeholders with your credentials.
# ==============================================================================

# MongoDB Connection URI (Atlas Cloud or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mdn2dez.mongodb.net/aura_restaurant?retryWrites=true&w=majority

# API Express Server Port
PORT=5000

# JWT Authentication Secret Key
JWT_SECRET=aura-production-jwt-secret-key-change-me

# Groq AI LLM API Key (For AURA AI Help Assistant Chatbot)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Environment Mode (development or production)
NODE_ENV=development
