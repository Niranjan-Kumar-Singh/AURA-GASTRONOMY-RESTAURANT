# ==============================================================================
# AURA GASTRONOMY - GITIGNORE SPECIFICATION
# ==============================================================================

# Node Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build & Compilation Outputs
dist/
**/dist/
build/
**/build/
target/
**/target/
.vite/
**/.vite/
*.tsbuildinfo
*.jar
*.war
*.class

# Maven / Java legacy tools
backend/tools/
tools/

# Environment & Local Secrets (ALLOW *.env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
!**/.env.example

# IDE & OS System Files
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
.tempmediaStorage/
.antigravity/

# Archive Files & Dump Backups
*.zip
*.tar.gz
*.rar
